# OS
.DS_Store

# Python
__pycache__/
*.pyc
.pytest_cache/

# Virtual environments
.venv/
venv/

# cr-renderer is a separate, external open-source project
# (https://github.com/CyberAgentAILab/cr-renderer), pulled in locally for
# reference/dev and installed by the engines via
# `pip install git+https://github.com/CyberAgentAILab/cr-renderer` — not
# vendored into this repo.
/cr-renderer/

# Generated run artifacts
output/*
!output/.gitkeep

# Downloaded base-model weights stay local; track the small trained Qwen adapter
# so teammates can use the same fine-tuned proposal model.
models/*
!models/qwen3-layout-lora/
!models/qwen3-layout-lora/**
!models/qwen3-layout-lora-v2/
!models/qwen3-layout-lora-v2/**
!models/qwen3-layout-lora-v2-expanded/
!models/qwen3-layout-lora-v2-expanded/**

# Local Crello downloads/exports contain dataset previews, embedded artwork, and
# fonts. Keep these generated local copies out of Git; other data/ files remain
# trackable. Recreate them with scripts/convert_crello_dataset.py.
/data